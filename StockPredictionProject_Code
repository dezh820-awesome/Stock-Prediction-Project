class SentimentEngagementAnalyzer:
    """
    End-to-end pipeline for sentiment-enhanced Tesla stock return prediction.

    Public API
    ----------
    fit(stock_df, tweet_df)
    predict(new_data, return_intervals, variant)
    summary()
    plot(kind)
    get_feature_importance()
    get_metrics()
    check_assumptions()

    Notes on Prediction Intervals
    -----------------------------
    If available, intervals are conformal: ŷ ± q̂ where q̂ is calibrated from
    training residuals for the requested model variant. This is distribution-free
    and tends to be more robust than t-based intervals under non-normal errors.
    """

    BASELINE_FEATURES = [
        "close", "volume",
        "sma_7", "sma_14", "sma_21",
        "ema_12", "ema_26",
        "rsi_14",
        "macd", "macd_signal", "macd_histogram",
        "volatility_7d", "volatility_14d",
        "atr_14",
        "bollinger_width", "bollinger_pct",
        "volume_ratio",
        "price_position", "high_low_ratio", "close_open_ratio",
        "price_momentum_5d",
        "sma_crossover",
        "lag1_return", "lag2_return", "lag3_return",
    ]

    SENTIMENT_FEATURES = [
        "positive_count", "negative_count", "neutral_count",
        "positive_ratio", "negative_ratio",
        "positive_confidence", "negative_confidence",
        "engagement_weighted_positive", "engagement_weighted_negative",
        "net_sentiment", "sentiment_score", "sentiment_diversity",
        "rolling_net_sentiment_3d", "rolling_net_sentiment_7d",
        "rolling_positive_ratio_3d", "rolling_positive_ratio_7d",
        "rolling_sentiment_score_3d", "rolling_diversity_7d",
        "rolling_ewp_7d",
        "lag1_positive_ratio", "lag1_net_sentiment",
        "lag1_sentiment_diversity", "lag1_engagement_weighted_positive",
        "lag1_sentiment_score",
    ]

    TARGET = "daily_return"

    def __init__(self, config: Optional[ModelConfig] = None):
        self.config       = config or ModelConfig()
        self._results:    Dict[str, ModelResults] = {}
        self._merged_df:  Optional[pd.DataFrame]  = None
        self._benchmarks: Dict[str, float]        = {}
        self._is_fitted   = False

    def fit(self, stock_df: pd.DataFrame, tweet_df: pd.DataFrame) -> "SentimentEngagementAnalyzer":
        """Full training pipeline."""
        self._log("=" * 68)
        self._log("  SentimentEngagementAnalyzer  —  fit()")
        self._log("=" * 68)

        tech_eng = TechnicalFeatureEngineer()
        sent_eng = SentimentFeatureEngineer(self.config.rolling_windows)

        stock_features  = tech_eng.build(stock_df)
        sentiment_daily = sent_eng.build(tweet_df)

        # Normalise index types for merging on date
        stock_features.index    = pd.to_datetime(stock_features.index).normalize().date
        sentiment_daily["date"] = pd.to_datetime(sentiment_daily["date"]).apply(
            lambda d: d.date() if hasattr(d, "date") else d
        )

        merged = stock_features.merge(
            sentiment_daily,
            left_index=True,
            right_on="date",
            how="inner",
        ).set_index("date")

        # Winsorise at 1st/99th percentile (fit-time robustness)
        # Note: clipping uses full merged sample here; if you want strict purity,
        # compute quantiles on train only and apply to both.
        for col in [self.TARGET] + [f for f in self.BASELINE_FEATURES if f in merged.columns]:
            lo, hi = merged[col].quantile([0.01, 0.99])
            merged[col] = merged[col].clip(lo, hi)

        self._merged_df = merged.dropna(subset=[self.TARGET]).sort_index()

        n_total  = len(self._merged_df)
        n_test   = max(int(n_total * self.config.test_size), 30)
        n_train  = n_total - n_test
        train_df = self._merged_df.iloc[:n_train]
        test_df  = self._merged_df.iloc[n_train:]

        self._log(
            f"\n  Dataset     : {n_total:,} trading days  "
            f"({self._merged_df.index[0]} → {self._merged_df.index[-1]})"
        )
        self._log(
            f"  Train       : {train_df.index[0]} → {train_df.index[-1]}  "
            f"({n_train:,} obs)"
        )
        self._log(
            f"  Test        : {test_df.index[0]}  → {test_df.index[-1]}   "
            f"({n_test:,} obs)"
        )

        validator = StatisticalValidator(self.config.confidence_level, self.config.random_state)
        self._benchmarks = validator.no_information_benchmarks(
            train_df[self.TARGET].values, test_df[self.TARGET].values
        )
        self._log(
            f"\n  Benchmarks  : random_walk R²={self._benchmarks['random_walk_r2']:.4f}  "
            f"mean_predictor R²={self._benchmarks['mean_predictor_r2']:.4f}"
        )

        self._log("\n  [1/2] Training baseline model (OHLCV only)...")
        self._train_model(train_df, test_df, FeatureSet.BASELINE, validator)

        self._log("  [2/2] Training sentiment-enhanced model (OHLCV + sentiment)...")
        self._train_model(train_df, test_df, FeatureSet.FULL, validator)

        base       = self._results[FeatureSet.BASELINE.value]
        full       = self._results[FeatureSet.FULL.value]
        y_test_arr = full.y_test

        f_stat, f_p = validator.nested_f_test(
            y_test_arr,
            base.y_pred_test,
            full.y_pred_test,
            k_restricted=len(base.features_used),
            k_full=len(full.features_used),
        )

        self._log(f"  Running {self.config.bootstrap_n:,} bootstrap iterations for ΔR² CI...")
        delta_obs, ci_lo, ci_hi, all_deltas = validator.bootstrap_delta_r2(
            y_test_arr,
            base.y_pred_test,
            full.y_pred_test,
            n_iter=self.config.bootstrap_n,
        )

        full.nested_f_stat      = f_stat
        full.nested_f_pvalue    = f_p
        full.bootstrap_delta_r2 = delta_obs
        full.bootstrap_ci_lo    = ci_lo
        full.bootstrap_ci_hi    = ci_hi
        full.bootstrap_ci_all   = all_deltas

        self._is_fitted = True
        self._log("\n  Fitting complete.")

        if self.config.verbose:
            self.summary()

        return self

    def _predict_from_variant(
        self,
        new_data: Union[pd.DataFrame, Dict],
        variant: FeatureSet,
        return_intervals: bool = False,
    ) -> pd.DataFrame:
        """Internal prediction helper for baseline vs full variants."""
        self._require_fitted()

        if isinstance(new_data, dict):
            new_data = pd.DataFrame([new_data])

        res = self._results[variant.value]
        features = res.features_used

        X = pd.DataFrame(index=new_data.index)
        for f in features:
            X[f] = new_data[f] if f in new_data.columns else 0.0

        X_scaled = res.scaler.transform(X.fillna(0).values)
        y_hat    = res.model.predict(X_scaled)

        out = pd.DataFrame({"prediction": y_hat}, index=new_data.index)

        if return_intervals:
            # Prefer conformal intervals if calibrated
            if res.conformal_q and res.conformal_q > 0:
                q = float(res.conformal_q)
                out["lower"] = y_hat - q
                out["upper"] = y_hat + q
                out["interval_width"] = out["upper"] - out["lower"]
                out["interval_method"] = "conformal"
            else:
                # Fallback: t-based using training residual std
                se = float(np.std(res.residuals_train))
                k = len(features)
                n_res = len(res.residuals_train)
                t_crit = stats.t.ppf(
                    0.5 + self.config.confidence_level / 2,
                    df=max(n_res - k - 1, 1),
                )
                out["lower"] = y_hat - t_crit * se
                out["upper"] = y_hat + t_crit * se
                out["interval_width"] = out["upper"] - out["lower"]
                out["interval_method"] = "t_resid_sd"

        return out

    def predict(
        self,
        new_data: Union[pd.DataFrame, Dict],
        return_intervals: bool = False,
        variant: FeatureSet = FeatureSet.FULL,
    ) -> pd.DataFrame:
        """
        Generate predictions from a fitted model variant.

        Parameters
        ----------
        variant : FeatureSet.BASELINE or FeatureSet.FULL (default FULL)
        """
        return self._predict_from_variant(new_data, variant=variant, return_intervals=return_intervals)

