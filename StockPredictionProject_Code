        ax.set_xlabel("Predicted"); ax.set_ylabel("Residuals")
        ax.set_title(f"(b) Residuals vs. Predicted\nDW={a.durbin_watson_stat:.3f}  BP p={a.breusch_pagan_p:.3f}")
        ax.legend(fontsize=8); ax.grid(alpha=0.3)

        ax = axes[1, 0]
        sm.qqplot(full.residuals_test, line="s", ax=ax, alpha=0.5, markersize=3, color="#C44E52")
        ax.set_title(f"(c) Normal Q-Q\nShapiro p={a.shapiro_wilk_p:.3f}, JB p={a.jarque_bera_p:.3f}")
        ax.grid(alpha=0.3)

        ax = axes[1, 1]
        res_std = full.residuals_test / (full.residuals_test.std() + 1e-9)
