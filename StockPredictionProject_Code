        panels = (
            ["comparison", "timeseries", "diagnostics", "coefficients", "correlation"]
            if kind == "all" else [kind]
        )
        for panel in panels:
            method = f"_plot_{panel}"
            if hasattr(self, method):
                getattr(self, method)(figsize)
            else:
                logger.warning(f"Unknown plot kind: '{panel}'")
        return self

    def get_feature_importance(self) -> pd.DataFrame:
        """Return coefficients sorted by absolute magnitude, with inference stats."""
        self._require_fitted()
        coeff = self._results[FeatureSet.FULL.value].inference.coefficients
        return (
            coeff[coeff["feature"] != "intercept"]
            .sort_values("abs_coefficient", ascending=False)
            .reset_index(drop=True)
        )

    def get_metrics(self) -> pd.DataFrame:
        """Return performance metrics for both the baseline and full models."""
        self._require_fitted()
        rows = []
        for key, res in self._results.items():
            rows.append({
                "model":       key,
                "n_features":  len(res.features_used),
                "train_r2":    res.train_r2,
                "test_r2":     res.test_r2,
                "cv_r2_mean":  res.cv_r2_mean,
                "cv_r2_std":   res.cv_r2_std,
                "test_rmse":   res.test_rmse,
                "test_mae":    res.test_mae,
                "adj_r2":      res.inference.adj_r2,
                "aic":         res.inference.aic,
                "bic":         res.inference.bic,
                "conformal_q": res.conformal_q,
            })
        return pd.DataFrame(rows)

    def check_assumptions(self) -> AssumptionTestResults:
        """Return diagnostics for the fitted full model."""
        self._require_fitted()
        return self._results[FeatureSet.FULL.value].assumptions

    def quick_analysis(self, stock_df: pd.DataFrame, tweet_df: pd.DataFrame) -> "SentimentEngagementAnalyzer":
        """Convenience method: fit + summary + all plots."""
        return self.fit(stock_df, tweet_df).plot("all")

    def export_results(self, output_dir: str = ".") -> "SentimentEngagementAnalyzer":
        """Export metrics and feature importance tables to CSV."""
        import os
        self._require_fitted()
        os.makedirs(output_dir, exist_ok=True)
        self.get_metrics().to_csv(f"{output_dir}/model_metrics.csv", index=False)
        self.get_feature_importance().to_csv(f"{output_dir}/feature_importance.csv", index=False)
        logger.info(f"Results exported to '{output_dir}/'")
        return self

    # ── Internal ─────────────────────────────────────────────────────────────

    def _get_feature_columns(self, feature_set: FeatureSet) -> List[str]:
        if feature_set == FeatureSet.BASELINE:
            pool = self.BASELINE_FEATURES
        elif feature_set == FeatureSet.SENTIMENT_ONLY:
            pool = self.SENTIMENT_FEATURES
        else:
            pool = self.BASELINE_FEATURES + self.SENTIMENT_FEATURES
        return [f for f in pool if f in self._merged_df.columns]

    def _apply_feature_selection(
        self,
        X_train: np.ndarray,
        y_train: np.ndarray,
        feature_names: List[str],
    ) -> Tuple[np.ndarray, List[str], List[int]]:
        """Apply configured feature selection strategy."""
        strategy = self.config.feature_selection
        n_feat   = len(feature_names)

        if strategy == FeatureSelectionStrategy.ALL_FEATURES:
            return X_train, feature_names, list(range(n_feat))

        if strategy == FeatureSelectionStrategy.TOP_K:
            correlations = np.array([
                abs(np.corrcoef(X_train[:, i], y_train)[0, 1]) if np.std(X_train[:, i]) > 0 else 0.0
                for i in range(n_feat)
            ])
            top_k = min(self.config.top_k_features, n_feat)
            idx   = list(np.argsort(correlations)[-top_k:])
            return X_train[:, idx], [feature_names[i] for i in idx], idx

        if strategy == FeatureSelectionStrategy.LOW_COLLINEARITY:
            keep_idx = list(range(n_feat))
            changed  = True
            while changed and len(keep_idx) > 1:
                changed = False
                X_sub   = sm.add_constant(X_train[:, keep_idx])
                vifs    = []
                for i in range(len(keep_idx)):
                    try:
                        vifs.append(variance_inflation_factor(X_sub, i + 1))
                    except Exception:
                        vifs.append(0.0)
                max_i = int(np.argmax(vifs))
                if vifs[max_i] > self.config.vif_threshold:
                    keep_idx.pop(max_i)
                    changed = True
            return X_train[:, keep_idx], [feature_names[i] for i in keep_idx], keep_idx

        return X_train, feature_names, list(range(n_feat))

    def _build_sklearn_model(self):
        mt = self.config.model_type
        if mt == ModelType.RIDGE:
            return Ridge(alpha=self.config.alpha, random_state=self.config.random_state)
        if mt == ModelType.LASSO:
            return Lasso(alpha=self.config.alpha, max_iter=20_000, random_state=self.config.random_state)
        return LinearRegression()

    @staticmethod
    def _conformal_quantile(abs_residuals: np.ndarray, alpha: float) -> float:
        """
        Split-conformal-style radius based on training residuals.
        Uses finite-sample correction: q = Quantile_{ceil((n+1)(1-alpha))/n}(|e|)
        Implemented as q_level = min(1, 1 - alpha + 1/n).
        """
        abs_residuals = np.asarray(abs_residuals, dtype=float)
        abs_residuals = abs_residuals[np.isfinite(abs_residuals)]
        n = len(abs_residuals)
        if n == 0:
            return 0.0
        q_level = min(1.0, 1.0 - alpha + 1.0 / n)
        return float(np.quantile(abs_residuals, q_level, method="higher" if hasattr(np, "quantile") else "linear"))

    def _train_model(
        self,
        train_df: pd.DataFrame,
        test_df: pd.DataFrame,
        feature_set: FeatureSet,
        validator: StatisticalValidator,
    ) -> None:
        """Train one model variant and store complete results."""
        candidate_features = self._get_feature_columns(feature_set)

        X_train_raw = train_df[candidate_features].fillna(0).values
        y_train     = train_df[self.TARGET].values
        X_test_raw  = test_df[candidate_features].fillna(0).values
        y_test      = test_df[self.TARGET].values

        # Feature selection (fit only on training data)
        X_train_sel, sel_features, sel_idx = self._apply_feature_selection(
            X_train_raw, y_train, candidate_features
        )
        X_test_sel = X_test_raw[:, sel_idx]

        # Standardise (fit only on training data)
        scaler     = StandardScaler()
        X_train_sc = scaler.fit_transform(X_train_sel)
        X_test_sc  = scaler.transform(X_test_sel)

        model        = self._build_sklearn_model()
        model.fit(X_train_sc, y_train)
        y_pred_train = model.predict(X_train_sc)
        y_pred_test  = model.predict(X_test_sc)

        # Fold-correct CV: scale inside each fold via Pipeline (prevents leakage)
        tscv = TimeSeriesSplit(n_splits=self.config.cv_folds)
        cv_pipe = Pipeline([
            ("scaler", StandardScaler()),
            ("model", self._build_sklearn_model()),
        ])
        cv_scores = cross_val_score(
            cv_pipe,
            X_train_sel, y_train,   # unscaled
            cv=tscv,
            scoring="r2",
        )

        # OLS inference (descriptive layer)
        inference = validator.run_ols_inference(y_train, X_train_sc, sel_features)

        # Diagnostics on test residuals (scaled design matrix for VIF/diagnostics)
        assumptions = validator.check_all_assumptions(y_test, y_pred_test, X_test_sc, sel_features)

        # Conformal interval calibration from training residuals
        alpha = 1.0 - float(self.config.confidence_level)
        conformal_q = self._conformal_quantile(np.abs(y_train - y_pred_train), alpha=alpha)

        res = ModelResults(
            feature_set     = feature_set.value,
            features_used   = sel_features,
            train_r2        = float(r2_score(y_train, y_pred_train)),
            test_r2         = float(r2_score(y_test, y_pred_test)),
            train_rmse      = float(np.sqrt(mean_squared_error(y_train, y_pred_train))),
            test_rmse       = float(np.sqrt(mean_squared_error(y_test, y_pred_test))),
            train_mae       = float(mean_absolute_error(y_train, y_pred_train)),
            test_mae        = float(mean_absolute_error(y_test, y_pred_test)),
            train_mse       = float(mean_squared_error(y_train, y_pred_train)),
            test_mse        = float(mean_squared_error(y_test, y_pred_test)),
            cv_r2_scores    = cv_scores,
            cv_r2_mean      = float(cv_scores.mean()),
            cv_r2_std       = float(cv_scores.std()),
            y_train         = y_train,
            y_pred_train    = y_pred_train,
            y_test          = y_test,
            y_pred_test     = y_pred_test,
            residuals_train = y_train - y_pred_train,
            residuals_test  = y_test  - y_pred_test,
            test_index      = test_df.index,
            conformal_q     = float(conformal_q),
            inference       = inference,
            assumptions     = assumptions,
            scaler          = scaler,
            model           = model,
        )
        self._results[feature_set.value] = res

        label = feature_set.value.upper().replace("_", " ")
        self._log(
            f"    [{label}]  "
            f"features={len(sel_features)}  "
            f"test_R²={res.test_r2:.4f}  "
            f"RMSE={res.test_rmse:.4f}  "
            f"MAE={res.test_mae:.4f}  "
            f"CV_R²={res.cv_r2_mean:.4f}±{res.cv_r2_std:.4f}  "
            f"q̂={res.conformal_q:.6f}"
        )

    # ── Plotting ─────────────────────────────────────────────────────────────

    def _plot_comparison(self, figsize: Tuple) -> None:
        base = self._results[FeatureSet.BASELINE.value]
        full = self._results[FeatureSet.FULL.value]

        fig, axes = plt.subplots(1, 3, figsize=(16, 5))
        fig.suptitle(
            "Comparison of Baseline and Sentiment-Enhanced Model Performance\n"
            "with Confidence Indicators",
            fontsize=13, fontweight="bold", y=1.01,
        )

        BLUE, GREEN = "#4C72B0", "#55A868"
        xlabels     = ["Baseline\n(Stock Only)", "Sentiment-Enhanced\n(Stock + Sentiment)"]

        metrics = [
            ("(a) Coefficient of Determination", "R² Score",
             [base.test_r2, full.test_r2],
             [base.cv_r2_std, full.cv_r2_std]),
            ("(b) Root Mean Squared Error", "RMSE",
             [base.test_rmse, full.test_rmse], None),
            ("(c) Mean Absolute Error", "MAE",
             [base.test_mae, full.test_mae], None),
        ]

        for ax, (title, ylabel, vals, errs) in zip(axes, metrics):
            bars = ax.bar(xlabels, vals, color=[BLUE, GREEN],
                          width=0.5, edgecolor="white", linewidth=0.5)
            if errs is not None:
                ax.errorbar([0, 1], vals, yerr=errs, fmt="none", color="black", capsize=5, linewidth=1.5)
            for bar, val in zip(bars, vals):
                ax.text(
                    bar.get_x() + bar.get_width() / 2,
                    bar.get_height() + abs(max(vals) - min(vals)) * 0.05,
                    f"{val:.4f}", ha="center", va="bottom",
                    fontsize=10, fontweight="bold",
                )
            delta = vals[1] - vals[0]
            sign  = "+" if delta > 0 else ""
            ax.text(
                0.5, 0.97,
                f"Δ = {sign}{delta:.4f}\nF={full.nested_f_stat:.2f}, p={full.nested_f_pvalue:.3f}",
                transform=ax.transAxes, ha="center", va="top",
                fontsize=8, color="#333333",
                bbox=dict(boxstyle="round,pad=0.3", fc="white", ec="grey", alpha=0.7),
            )
            spread = abs(max(vals) - min(vals))
            ax.set_ylim(min(vals) - spread * 0.8, max(vals) + spread * 3.5)
            ax.set_title(title, fontsize=10, fontweight="bold")
            ax.set_ylabel(ylabel, fontsize=9)
            ax.grid(axis="y", alpha=0.3, linestyle="--")
            ax.spines[["top", "right"]].set_visible(False)

        plt.tight_layout()
        plt.show()

    def _plot_timeseries(self, figsize: Tuple) -> None:
        base = self._results[FeatureSet.BASELINE.value]
        full = self._results[FeatureSet.FULL.value]

        try:
            idx = pd.to_datetime(full.test_index)
        except Exception:
            idx = np.arange(len(full.y_test))

        # Prediction intervals: use conformal if available, else fallback
        if full.conformal_q and full.conformal_q > 0:
            q = float(full.conformal_q)
            pi_lo = full.y_pred_test - q
            pi_hi = full.y_pred_test + q
            interval_label = f"{int(self.config.confidence_level*100)}% Conformal Interval (ŷ ± q̂)"
        else:
            se     = np.std(full.residuals_train)
            k      = len(full.features_used)
            n_res  = len(full.residuals_train)
            t_crit = stats.t.ppf(0.5 + self.config.confidence_level / 2, df=max(n_res - k - 1, 1))
            pi_lo  = full.y_pred_test - t_crit * se
            pi_hi  = full.y_pred_test + t_crit * se
            interval_label = f"{int(self.config.confidence_level*100)}% Interval (t-resid SD)"

        coverage = float(np.mean((full.y_test >= pi_lo) & (full.y_test <= pi_hi)))

        fig, ax = plt.subplots(figsize=(16, 6))
        ax.fill_between(idx, pi_lo, pi_hi, alpha=0.18, color="#55A868",
                        label=interval_label)
        ax.plot(idx, full.y_test, color="black", lw=1.5, label="Actual Returns", zorder=5)
        ax.plot(idx, base.y_pred_test, color="#4C72B0", lw=0.9, ls="--",
                label="Baseline Predictions", alpha=0.75)
        ax.plot(idx, full.y_pred_test, color="#55A868", lw=0.9, ls="--",
                label="Sentiment-Enhanced Predictions", alpha=0.9)
        ax.axhline(0, color="grey", lw=0.5, ls=":")
        ax.set_xlabel("Date", fontsize=11)
        ax.set_ylabel("Daily Return", fontsize=11)
        ax.set_title(
            "Tesla Stock Return Predictions: Test Period\nBaseline vs Sentiment-Enhanced Model",
            fontsize=12, fontweight="bold",
        )
        ax.legend(fontsize=9, loc="upper left")
        ax.text(
            0.985, 0.04,
            f"Sentiment-Enhanced Model\n"
            f"R²   = {full.test_r2:.3f}\n"
            f"RMSE = {full.test_rmse:.3f}\n"
            f"MAE  = {full.test_mae:.3f}\n"
            f"Coverage = {coverage:.1%}",
            transform=ax.transAxes, ha="right", va="bottom",
            fontsize=8.5,
            bbox=dict(boxstyle="round,pad=0.4", fc="white", ec="grey", alpha=0.85),
        )
        ax.grid(alpha=0.2)
        ax.spines[["top", "right"]].set_visible(False)
        plt.tight_layout()
        plt.show()

    def _plot_diagnostics(self, figsize: Tuple) -> None:
        full = self._results[FeatureSet.FULL.value]
        a    = full.assumptions

        fig, axes = plt.subplots(2, 2, figsize=(14, 10))
        fig.suptitle("Diagnostic Plots — Sentiment-Enhanced Model (Test Residuals)",
