# Sentiment Feature Engineer
# ============================================================================

class SentimentFeatureEngineer:
    """
    Constructs daily sentiment features from tweet-level FinBERT output.

    Input requirements
    ------------------
    DataFrame with columns:
        createdAt     — timestamp of the tweet
        sentiment     — Positive / Negative / Neutral (from FinBERT)
        confidence    — FinBERT confidence score
        retweetCount, replyCount, likeCount, quoteCount, viewCount  (optional)
    """

    ENGAGEMENT_COLS = ["retweetCount", "replyCount", "likeCount", "quoteCount", "viewCount"]
    RENAME_MAP = {
        "retweetCount": "retweet_avg",
        "replyCount":   "reply_avg",
        "likeCount":    "like_avg",
        "quoteCount":   "quote_avg",
        "viewCount":    "view_avg",
    }

    def __init__(self, rolling_windows: Optional[List[int]] = None):
        self.rolling_windows = rolling_windows or [3, 7, 14]

    def build(self, tweet_df: pd.DataFrame) -> pd.DataFrame:
        """Build daily sentiment features."""
        df = tweet_df.copy()
        if "createdAt" not in df.columns:
            raise ValueError("Tweet DataFrame must include 'createdAt' column.")
        if "sentiment" not in df.columns:
            raise ValueError("Tweet DataFrame must include 'sentiment' column.")
        if "confidence" not in df.columns:
            raise ValueError("Tweet DataFrame must include 'confidence' column.")

        df["date"] = pd.to_datetime(df["createdAt"]).dt.date

        # ── Engagement aggregation ────────────────────────────────────────────
        avail_eng = [c for c in self.ENGAGEMENT_COLS if c in df.columns]
        if avail_eng:
            engagement_df = (
                df.groupby("date")
                .agg({c: "mean" for c in avail_eng})
                .rename(columns=self.RENAME_MAP)
                .reset_index()
            )
        else:
            engagement_df = df[["date"]].drop_duplicates().copy()
            for v in self.RENAME_MAP.values():
                engagement_df[v] = 0.0

        # ── Per-sentiment daily stats ─────────────────────────────────────────
        sent_frames = []
        for label in ("Positive", "Negative", "Neutral"):
            sub = df[df["sentiment"] == label]
            if len(sub) == 0:
                continue
            agg = (
                sub.groupby("date")
                .agg(
                    **{f"{label.lower()}_count":      ("confidence", "size")},
                    **{f"{label.lower()}_confidence": ("confidence", "mean")},
                )
                .reset_index()
            )
            sent_frames.append(agg)

        daily = engagement_df.copy()
        for sf in sent_frames:
            daily = daily.merge(sf, on="date", how="left")

        # Fill missing sentiment columns
        for col in [
            "positive_count", "negative_count", "neutral_count",
            "positive_confidence", "negative_confidence", "neutral_confidence",
        ]:
            if col not in daily.columns:
                daily[col] = 0.0
        daily = daily.fillna(0)

        # ── Derived features ──────────────────────────────────────────────────
        daily["total_tweets"] = (
            daily["positive_count"]
            + daily["negative_count"]
            + daily["neutral_count"]
        )
        for pol in ("positive", "negative", "neutral"):
            daily[f"{pol}_ratio"] = np.where(
                daily["total_tweets"] > 0,
                daily[f"{pol}_count"] / daily["total_tweets"],
                0.0,
            )

        # Engagement-weighted sentiment using log-transformed like_avg
        like_col = "like_avg" if "like_avg" in daily.columns else None
        like_weight = np.log1p(daily[like_col]) if like_col else pd.Series(
            np.ones(len(daily)), index=daily.index
        )
        daily["engagement_weighted_positive"] = (
            daily["positive_count"] * daily["positive_confidence"] * like_weight
        )
        daily["engagement_weighted_negative"] = (
            daily["negative_count"] * daily["negative_confidence"] * like_weight
        )
        daily["net_sentiment"]   = daily["positive_count"] - daily["negative_count"]
        daily["sentiment_score"] = (
            daily["engagement_weighted_positive"] - daily["engagement_weighted_negative"]
        )

        # Shannon entropy — sentiment diversity
        eps = 1e-9
        daily["sentiment_diversity"] = -(
            daily["positive_ratio"].clip(lower=eps) * np.log(daily["positive_ratio"].clip(lower=eps))
            + daily["negative_ratio"].clip(lower=eps) * np.log(daily["negative_ratio"].clip(lower=eps))
            + daily["neutral_ratio"].clip(lower=eps)  * np.log(daily["neutral_ratio"].clip(lower=eps))
        )

        # ── Sort by date before rolling ───────────────────────────────────────
        daily = daily.sort_values("date").reset_index(drop=True)

        # ── Rolling features ──────────────────────────────────────────────────
        rolling_spec = {
            "net_sentiment":                "rolling_net_sentiment",
            "positive_ratio":               "rolling_positive_ratio",
            "sentiment_score":              "rolling_sentiment_score",
            "sentiment_diversity":          "rolling_diversity",
            "engagement_weighted_positive": "rolling_ewp",
        }
        for src, prefix in rolling_spec.items():
            for w in self.rolling_windows:
                daily[f"{prefix}_{w}d"] = daily[src].rolling(w, min_periods=1).mean()

        # ── 1-day lag features ────────────────────────────────────────────────
        lag_cols = [
            "positive_ratio", "net_sentiment", "sentiment_diversity",
            "engagement_weighted_positive", "sentiment_score",
        ]
        for col in lag_cols:
            daily[f"lag1_{col}"] = daily[col].shift(1)

        daily = daily.dropna(subset=["lag1_positive_ratio"]).reset_index(drop=True)

        logger.info(
            f"Sentiment features: {len(daily)} daily rows, {len(daily.columns)} columns"
        )
        return daily


