        ax.set_title("(d) Residual Distribution")
        ax.legend(fontsize=8); ax.grid(alpha=0.3)
        ax.text(
            0.97, 0.97,
            f"Mean: {full.residuals_test.mean():.4f}\n"
            f"Std:  {full.residuals_test.std():.4f}\n"
            f"Skew: {a.residual_skew:.3f}\n"
            f"Kurt: {a.residual_kurtosis:.3f}\n"
            f"corr(res,fitted): {a.residual_pred_corr:.3f}",
            transform=ax.transAxes, ha="right", va="top", fontsize=8.5,
            bbox=dict(boxstyle="round", fc="white", ec="grey", alpha=0.85),
        )

        plt.tight_layout()
        plt.show()

    def _plot_coefficients(self, figsize: Tuple) -> None:
        full  = self._results[FeatureSet.FULL.value]
        coeff = (
            full.inference.coefficients
            .query("feature != 'intercept'")
            .sort_values("abs_coefficient", ascending=True)
            .tail(15)
        )

        def _color(p: float) -> str:
            if p < 0.001: return "#C44E52"
            if p < 0.01:  return "#DD8452"
            if p < 0.05:  return "#CCBB44"
            return "#BBBBBB"

        colors = [_color(p) for p in coeff["p_value"]]

        fig, ax = plt.subplots(figsize=(12, 7))
        ax.barh(coeff["feature"], coeff["coefficient"], color=colors, edgecolor="white", linewidth=0.5)
        ax.errorbar(
            coeff["coefficient"], range(len(coeff)),
            xerr=[
                coeff["coefficient"] - coeff["ci_lower"],
                coeff["ci_upper"]    - coeff["coefficient"],
            ],
            fmt="none", color="black", capsize=3, linewidth=1.2,
        )

        max_abs = coeff["abs_coefficient"].max()
        for i, (_, row) in enumerate(coeff.iterrows()):
            stars = "***" if row["p_value"] < 0.001 else "**" if row["p_value"] < 0.01 else "*" if row["p_value"] < 0.05 else "n.s."
            x_off = row["ci_upper"] + max_abs * 0.02
            ax.text(x_off, i, f" {row['coefficient']:.4f} {stars}", va="center", fontsize=8)

        ax.axvline(0, color="black", lw=0.8)
        ax.set_xlabel("Coefficient Value (β)", fontsize=11)
        ax.set_title("Feature Importance with Confidence Intervals", fontsize=12, fontweight="bold")
        ax.grid(axis="x", alpha=0.3, linestyle="--")
        ax.spines[["top", "right"]].set_visible(False)

        from matplotlib.patches import Patch
        ax.legend(
            handles=[
                Patch(color="#C44E52", label="p < 0.001  (***)"),
                Patch(color="#DD8452", label="p < 0.01   (**)"),
                Patch(color="#CCBB44", label="p < 0.05   (*)"),
                Patch(color="#BBBBBB", label="p ≥ 0.05   (n.s.)"),
            ],
            loc="lower right", fontsize=9,
        )
        plt.tight_layout()
        plt.show()

    def _plot_correlation(self, figsize: Tuple) -> None:
        full  = self._results[FeatureSet.FULL.value]
        cols  = [self.TARGET] + full.features_used[:20]
        avail = [c for c in cols if c in self._merged_df.columns]
        corr  = self._merged_df[avail].corr()

        fig, ax = plt.subplots(figsize=(14, 11))
        sns.heatmap(
            corr, annot=True, fmt=".2f", cmap="coolwarm",
            center=0, vmin=-1, vmax=1,
            linewidths=0.4, square=True, ax=ax,
            annot_kws={"size": 7},
        )
        ax.set_title("Feature Correlation Matrix with Target Variable",
                     fontsize=12, fontweight="bold")
        plt.xticks(rotation=45, ha="right", fontsize=8)
        plt.yticks(rotation=0, fontsize=8)
        plt.tight_layout()
        plt.show()

    # ── Utilities ────────────────────────────────────────────────────────────

    def _log(self, msg: str) -> None:
        if self.config.verbose:
            print(msg)

    def _require_fitted(self) -> None:
        if not self._is_fitted:
            raise RuntimeError("Model has not been fitted. Call fit(stock_df, tweet_df) first.")

    def __repr__(self) -> str:
        status = "fitted" if self._is_fitted else "not fitted"
        return (
            f"SentimentEngagementAnalyzer("
            f"model={self.config.model_type.value}, "
            f"features={self.config.feature_set.value}, "
            f"status={status})"
        )


