class RealTimeInferenceEngine:
    """
    Wraps a fitted SentimentEngagementAnalyzer to provide live stock data
    retrieval and optional analysis via yfinance.

    Notes
    -----
    If live tweet data is not available, it is recommended to use the baseline
    (technical-only) model variant for realtime predictions.
    """

    SECTOR_ETFS = {
        "Technology":             "XLK",
        "Healthcare":             "XLV",
        "Financials":             "XLF",
        "Energy":                 "XLE",
        "Consumer Discretionary": "XLY",
        "Consumer Staples":       "XLP",
        "Industrials":            "XLI",
        "Materials":              "XLB",
        "Real Estate":            "XLRE",
        "Utilities":              "XLU",
        "Communications":         "XLC",
    }

    def __init__(self, analyzer: Optional[SentimentEngagementAnalyzer] = None):
        self.analyzer  = analyzer
        self._tech_eng = TechnicalFeatureEngineer()

    def _fetch_ohlcv(self, symbol: str, period: str = "6mo") -> pd.DataFrame:
        """Fetch OHLCV from yfinance and normalise column names."""
        try:
            import yfinance as yf
        except ImportError as e:
            raise ImportError("yfinance required: pip install yfinance") from e

        hist = yf.Ticker(symbol).history(period=period)[["Open", "High", "Low", "Close", "Volume"]]
        hist.columns = [c.lower() for c in hist.columns]
        hist.index   = pd.to_datetime(hist.index).normalize()
        if hist.empty:
            raise ValueError(f"No data returned for ticker '{symbol}'")
        return hist

    def _fetch_info(self, symbol: str) -> Dict:
        """Fetch yfinance info dict safely."""
        try:
            import yfinance as yf
            return yf.Ticker(symbol).info or {}
        except Exception:
            return {}

    def predict_from_ticker(
        self,
        symbol: str,
        period: str = "6mo",
        model_variant: FeatureSet = FeatureSet.BASELINE,
    ) -> pd.DataFrame:
        """
        Fetch recent OHLCV, compute technical features, and return model
        predictions with intervals (conformal if available).

        By default, this uses the BASELINE model variant, since realtime tweet
        features are not included here.
        """
        if self.analyzer is None or not self.analyzer._is_fitted:
            raise RuntimeError("Provide a fitted SentimentEngagementAnalyzer to the engine.")

        hist = self._fetch_ohlcv(symbol, period)
        df   = self._tech_eng.build(hist)
        df.index = df.index.date

        if model_variant == FeatureSet.FULL:
            # No live sentiment in this utility -> zero-fill sentiment columns
            for col in SentimentEngagementAnalyzer.SENTIMENT_FEATURES:
                if col not in df.columns:
                    df[col] = 0.0

        return self.analyzer.predict(df, return_intervals=True, variant=model_variant)

    def technical_snapshot(self, symbol: str) -> Dict:
        """Compute a concise technical indicator snapshot (no model needed)."""
        hist = self._fetch_ohlcv(symbol, period="6mo")
        df   = self._tech_eng.build(hist)
        row  = df.iloc[-1]
        prev = df.iloc[-2] if len(df) > 1 else row

        rsi       = float(row.get("rsi_14", 50))
        rsi_label = "Oversold" if rsi < 30 else "Overbought" if rsi > 70 else "Neutral"

        macd_c  = float(row.get("macd", 0))
        macd_s  = float(row.get("macd_signal", 0))
        macd_p  = float(prev.get("macd", 0))
        macd_sp = float(prev.get("macd_signal", 0))
        macd_signal = (
            "BUY"  if (macd_c > macd_s and macd_p <= macd_sp) else
            "SELL" if (macd_c < macd_s and macd_p >= macd_sp) else
            "HOLD"
        )

        bp = float(row.get("bollinger_pct", 0.5))
        bb_pos = "UPPER" if bp > 0.8 else "LOWER" if bp < 0.2 else "MIDDLE"

        vr = float(row.get("volume_ratio", 1.0))
        vol_trend = "INCREASING" if vr > 1.2 else "DECREASING" if vr < 0.8 else "NORMAL"

        return {
            "symbol":            symbol,
            "date":              str(df.index[-1]),
            "close":             float(row.get("close", 0)),
            "daily_return":      float(row.get("daily_return", 0)),
            "rsi_14":            rsi,
            "rsi_label":         rsi_label,
            "macd":              float(row.get("macd", 0)),
            "macd_signal":       macd_signal,
            "macd_histogram":    float(row.get("macd_histogram", 0)),
            "bollinger_pct":     bp,
            "bollinger_pos":     bb_pos,
            "bollinger_width":   float(row.get("bollinger_width", 0)),
            "volume_ratio":      vr,
            "volume_trend":      vol_trend,
            "volatility_14d":    float(row.get("volatility_14d", 0)),
            "atr_14":            float(row.get("atr_14", 0)),
            "sma_7":             float(row.get("sma_7", 0)),
            "sma_14":            float(row.get("sma_14", 0)),
            "price_momentum_5d": float(row.get("price_momentum_5d", 0)),
            "obv":               float(row.get("obv", 0)),
        }

    def fundamental_snapshot(self, symbol: str) -> Dict:
        """Fetch fundamental data from yfinance and produce a simple score + targets."""
        info = self._fetch_info(symbol)

        def _f(key: str, scale: float = 1.0) -> float:
            v = info.get(key)
            return float(v) * scale if v is not None else 0.0

        current_price   = _f("currentPrice") or _f("regularMarketPrice")
        pe_ratio        = _f("trailingPE")
        forward_pe      = _f("forwardPE")
        peg_ratio       = _f("pegRatio")
        roe             = _f("returnOnEquity", 100)
        roa             = _f("returnOnAssets", 100)
        debt_equity     = _f("debtToEquity") / 100
        gross_margin    = _f("grossMargins", 100)
        rev_growth      = _f("revenueGrowth", 100)
        earnings_growth = _f("earningsGrowth", 100)
        dividend_yield  = _f("dividendYield", 100)
        analyst_target  = _f("targetMeanPrice") or current_price

        rec_raw = (info.get("recommendationKey") or "hold").lower()
        rec_map = {
            "strong_buy": "STRONG_BUY", "buy": "BUY",
            "hold": "HOLD", "sell": "SELL", "strong_sell": "STRONG_SELL",
        }
        analyst_consensus = rec_map.get(rec_raw, "HOLD")

        score, factors, risks = 0, [], []

        if 0 < pe_ratio < 15:
            score += 1; factors.append(f"Lower trailing P/E ({pe_ratio:.1f})")
        elif pe_ratio > 35:
            score -= 1; risks.append(f"Higher trailing P/E ({pe_ratio:.1f})")

        if roe > 15:
            score += 1; factors.append(f"ROE {roe:.1f}%")
        elif 0 < roe < 5:
            score -= 1; risks.append(f"Lower ROE {roe:.1f}%")
        elif roe < 0:
            score -= 2; risks.append(f"Negative ROE {roe:.1f}%")

        if debt_equity > 1.5:
            score -= 1; risks.append(f"Higher debt/equity {debt_equity:.2f}")
        elif 0 <= debt_equity < 0.5:
            score += 1; factors.append(f"Lower debt/equity {debt_equity:.2f}")

        if rev_growth > 10:
            score += 1; factors.append(f"Revenue growth {rev_growth:.1f}%")
        elif rev_growth < 0:
            score -= 1; risks.append(f"Declining revenue {rev_growth:.1f}%")

        if gross_margin > 50:
            score += 1; factors.append(f"Gross margin {gross_margin:.1f}%")

        analyst_scores = {"STRONG_BUY": 2, "BUY": 1, "HOLD": 0, "SELL": -1, "STRONG_SELL": -2}
        score += analyst_scores.get(analyst_consensus, 0)
        if analyst_consensus != "HOLD":
            factors.append(f"Analyst consensus: {analyst_consensus}")

        if   score >= 4:  recommendation, confidence = "STRONG_BUY",  0.87
        elif score >= 2:  recommendation, confidence = "BUY",         0.74
        elif score <= -4: recommendation, confidence = "STRONG_SELL", 0.87
        elif score <= -2: recommendation, confidence = "SELL",        0.74
        else:             recommendation, confidence = "HOLD",        0.60

        upside = (analyst_target / current_price) if current_price > 0 else 1.0
        price_targets = {
            "conservative": round(current_price * max(1.0, upside * 0.90), 2),
            "base_case":    round(analyst_target, 2),
            "optimistic":   round(current_price * max(1.05, upside * 1.10), 2),
            "pessimistic":  round(current_price * min(0.95, upside * 0.80), 2),
        }

        return {
            "symbol":            symbol,
            "company_name":      info.get("longName", symbol),
            "current_price":     round(current_price, 2),
            "market_cap":        info.get("marketCap"),
            "pe_ratio":          round(pe_ratio, 1),
            "forward_pe":        round(forward_pe, 1),
            "peg_ratio":         round(peg_ratio, 2),
            "roe":               round(roe, 1),
            "roa":               round(roa, 1),
            "debt_equity":       round(debt_equity, 2),
            "gross_margin":      round(gross_margin, 1),
            "revenue_growth":    round(rev_growth, 1),
            "earnings_growth":   round(earnings_growth, 1),
            "dividend_yield":    round(dividend_yield, 2),
            "analyst_consensus": analyst_consensus,
            "analyst_target":    round(analyst_target, 2),
            "score":             score,
            "recommendation":    recommendation,
            "confidence":        confidence,
            "key_factors":       factors[:5],
            "risks":             risks[:5],
            "price_targets":     price_targets,
        }

    def full_stock_analysis(self, symbol: str) -> Dict:
        """Combined technical + fundamental analysis; baseline prediction by default."""
        analysis = {
            "technical":   self.technical_snapshot(symbol),
            "fundamental": self.fundamental_snapshot(symbol),
        }
        if self.analyzer is not None and self.analyzer._is_fitted:
            try:
                preds  = self.predict_from_ticker(symbol, model_variant=FeatureSet.BASELINE)
                latest = float(preds["prediction"].iloc[-1])
                analysis["model_prediction"] = {
                    "variant":          "BASELINE",
                    "predicted_return": round(latest, 5),
                    "direction":        "UP" if latest > 0 else "DOWN",
                    "lower_95":         round(float(preds["lower"].iloc[-1]), 5) if "lower" in preds.columns else None,
                    "upper_95":         round(float(preds["upper"].iloc[-1]), 5) if "upper" in preds.columns else None,
                    "interval_method":  preds.get("interval_method", pd.Series([""])).iloc[-1] if "interval_method" in preds.columns else "",
                    "note":             "Baseline (technical-only) model used for realtime utility.",
                }
            except Exception as e:
                analysis["model_prediction"] = {"error": str(e)}
        return analysis

    def sector_rotation_analysis(self) -> pd.DataFrame:
        """Rank sector ETFs vs SPY over 6 months (simple relative performance)."""
        try:
            import yfinance as yf
        except ImportError as e:
            raise ImportError("yfinance required: pip install yfinance") from e

        spy_hist   = yf.Ticker("SPY").history(period="6mo")["Close"]
        spy_return = float((spy_hist.iloc[-1] / spy_hist.iloc[0] - 1) * 100)

        rows = []
        for sector, etf in self.SECTOR_ETFS.items():
            try:
                snap = self.technical_snapshot(etf)
                hist = self._fetch_ohlcv(etf, period="6mo")
                abs_ret = float((hist["close"].iloc[-1] / hist["close"].iloc[0] - 1) * 100)
                rel_ret = abs_ret - spy_return
                momentum = float(
                    (hist["close"].iloc[-1] / hist["close"].iloc[-10] - 1) * 100
                    if len(hist) >= 10 else 0.0
                )
                rows.append({
                    "sector":          sector,
                    "etf":             etf,
                    "abs_return_6m_%": round(abs_ret, 2),
                    "rel_to_spy_%":    round(rel_ret, 2),
                    "momentum_2w_%":   round(momentum, 2),
                    "rsi":             round(snap["rsi_14"], 1),
                    "macd_signal":     snap["macd_signal"],
                    "volume_trend":    snap["volume_trend"],
                    "volatility_14d":  round(snap["volatility_14d"], 4),
                    "bollinger_pos":   snap.get("bollinger_pos", "MIDDLE"),
                })
            except Exception as e:
                logger.warning(f"Could not analyse {sector} ({etf}): {e}")

        df = pd.DataFrame(rows)
        return df.sort_values("rel_to_spy_%", ascending=False).reset_index(drop=True)

