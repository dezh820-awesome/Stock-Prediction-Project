class TechnicalFeatureEngineer:
    """Computes OHLCV-derived technical indicators using backward-looking windows."""

    def build(self, ohlcv_df: pd.DataFrame) -> pd.DataFrame:
        """
        Parameters
        ----------
        ohlcv_df : DataFrame with columns open, high, low, close, volume
                   and a DatetimeIndex or date index.
        """
        df = ohlcv_df.copy().sort_index()

        required = {"open", "high", "low", "close", "volume"}
        missing  = required - set(df.columns)
        if missing:
            raise ValueError(f"OHLCV DataFrame missing columns: {missing}")

        # ── Returns ───────────────────────────────────────────────────────────
        df["daily_return"] = df["close"].pct_change()

        prev_close = df["close"].shift(1)
        safe_ratio = df["close"] / prev_close.replace(0, np.nan)
        df["log_return"] = np.log(safe_ratio.where(safe_ratio > 0, np.nan))

        # ── Moving averages ───────────────────────────────────────────────────
        for w in [7, 14, 21]:
            df[f"sma_{w}"] = df["close"].rolling(w, min_periods=1).mean()
        df["ema_12"] = df["close"].ewm(span=12, adjust=False).mean()
        df["ema_26"] = df["close"].ewm(span=26, adjust=False).mean()
        df["sma_crossover"] = (df["sma_7"] > df["sma_14"]).astype(float)

        # ── RSI ──────────────────────────────────────────────────────────────
        df["rsi_14"] = self._rsi(df["close"], 14)

        # ── MACD ─────────────────────────────────────────────────────────────
        df["macd"]           = df["ema_12"] - df["ema_26"]
        df["macd_signal"]    = df["macd"].ewm(span=9, adjust=False).mean()
        df["macd_histogram"] = df["macd"] - df["macd_signal"]

        # ── Price momentum ───────────────────────────────────────────────────
        df["price_momentum_5d"]  = df["close"].pct_change(5)
        df["price_momentum_10d"] = df["close"].pct_change(10)

        # ── Volatility ───────────────────────────────────────────────────────
        df["volatility_7d"]  = df["daily_return"].rolling(7,  min_periods=2).std()
        df["volatility_14d"] = df["daily_return"].rolling(14, min_periods=2).std()
        df["atr_14"]         = self._atr(df, 14)

        # ── Bollinger Bands ──────────────────────────────────────────────────
        bb_mean = df["close"].rolling(20, min_periods=5).mean()
        bb_std  = df["close"].rolling(20, min_periods=5).std()
        df["bollinger_upper"] = bb_mean + 2 * bb_std
        df["bollinger_lower"] = bb_mean - 2 * bb_std
        df["bollinger_width"] = (df["bollinger_upper"] - df["bollinger_lower"]) / (bb_mean + 1e-9)
        df["bollinger_pct"]   = (df["close"] - df["bollinger_lower"]) / (
            (df["bollinger_upper"] - df["bollinger_lower"]) + 1e-9
        )

        # ── Volume ───────────────────────────────────────────────────────────
        df["volume_sma_10"] = df["volume"].rolling(10, min_periods=1).mean()
        df["volume_ratio"]  = df["volume"] / (df["volume_sma_10"] + 1e-9)
        df["obv"]           = self._obv(df)

        # ── Price structure ──────────────────────────────────────────────────
        df["high_low_ratio"]   = df["high"] / (df["low"] + 1e-9)
        df["close_open_ratio"] = df["close"] / (df["open"] + 1e-9)
        df["price_position"]   = (df["close"] - df["low"]) / ((df["high"] - df["low"]) + 1e-9)

        # ── Lag returns ──────────────────────────────────────────────────────
        for lag in [1, 2, 3]:
            df[f"lag{lag}_return"] = df["daily_return"].shift(lag)

        df = df.dropna(subset=["daily_return", "rsi_14", "macd"])
        logger.info(f"Technical features: {len(df)} trading days, {len(df.columns)} columns")
        return df

    @staticmethod
    def _rsi(prices: pd.Series, window: int = 14) -> pd.Series:
        """Wilder's RSI."""
        delta    = prices.diff()
        gain     = delta.clip(lower=0)
        loss     = (-delta.clip(upper=0))
        avg_gain = gain.ewm(com=window - 1, min_periods=window).mean()
        avg_loss = loss.ewm(com=window - 1, min_periods=window).mean()
        rs       = avg_gain / (avg_loss + 1e-9)
        return 100 - (100 / (1 + rs))

    @staticmethod
    def _atr(df: pd.DataFrame, window: int = 14) -> pd.Series:
        """Average True Range."""
        hl  = df["high"] - df["low"]
        hpc = (df["high"] - df["close"].shift(1)).abs()
        lpc = (df["low"]  - df["close"].shift(1)).abs()
        tr  = pd.concat([hl, hpc, lpc], axis=1).max(axis=1)
        return tr.ewm(com=window - 1, min_periods=window).mean()

    @staticmethod
    def _obv(df: pd.DataFrame) -> pd.Series:
        """On-Balance Volume."""
        direction = np.sign(df["close"].diff()).fillna(0)
        return (direction * df["volume"]).cumsum()


