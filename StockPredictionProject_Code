# Tweet Preprocessor + FinBERT Inference
# ============================================================================

class TweetPreprocessor:
    """
    Cleans raw tweet text and optionally runs FinBERT sentiment inference.

    Pipeline
    --------
    1. Remove exact duplicates on tweet text
    2. Filter non-English tweets (ASCII-ratio heuristic)
    3. Remove bot-like / repetitive content (length + word-frequency heuristic)
    4. Strip URLs, @mentions, hashtag symbols, emojis, excess whitespace
    5. Run FinBERT (yiyanghkust/finbert-tone) in configurable batch sizes
    6. Normalise label names (Positive / Negative / Neutral)
    7. Drop predictions below min_confidence threshold

    Notes
    -----
    The language and bot filters are heuristics and may remove some valid content.
    """

    URL_RE        = re.compile(r"https?://\S+|www\.\S+")
    MENTION_RE    = re.compile(r"@\w+")
    HASHTAG_RE    = re.compile(r"#(\w+)")
    WHITESPACE_RE = re.compile(r"\s+")

    LABEL_MAP = {
        "Positive": "Positive", "POSITIVE": "Positive", "positive": "Positive",
        "Negative": "Negative", "NEGATIVE": "Negative", "negative": "Negative",
        "Neutral":  "Neutral",  "NEUTRAL":  "Neutral",  "neutral":  "Neutral",
    }

    def __init__(self, min_confidence: float = 0.60, batch_size: int = 64):
        self.min_confidence = min_confidence
        self.batch_size     = batch_size
        self._pipeline      = None

    def _load_pipeline(self):
        """Lazy-load FinBERT to avoid import overhead when not needed."""
        if self._pipeline is None:
            try:
                from transformers import pipeline as hf_pipeline
                logger.info("Loading FinBERT (yiyanghkust/finbert-tone)...")
                self._pipeline = hf_pipeline(
                    "sentiment-analysis",
                    model="yiyanghkust/finbert-tone",
                    truncation=True,
                    max_length=128,
                )
                logger.info("FinBERT loaded.")
            except ImportError as e:
                raise ImportError(
                    "transformers + torch required: pip install transformers torch"
                ) from e
        return self._pipeline

    @staticmethod
    def clean_text(text: str) -> str:
        """Remove noise: URLs, @mentions, hashtag symbols, emojis, whitespace."""
        if not isinstance(text, str):
            return ""
        text = TweetPreprocessor.URL_RE.sub("", text)
        text = TweetPreprocessor.MENTION_RE.sub("", text)
        text = TweetPreprocessor.HASHTAG_RE.sub(r"\1", text)
        # Strip emoji / symbols and non-BMP characters
        text = "".join(
            c for c in text
            if unicodedata.category(c) not in ("So", "Cs") and ord(c) < 65536
        )
        return TweetPreprocessor.WHITESPACE_RE.sub(" ", text).strip()

    @staticmethod
    def is_english(text: str, threshold: float = 0.80) -> bool:
        """Heuristic: fraction of ASCII characters above threshold => likely English."""
        if not text:
            return False
        return sum(1 for c in text if ord(c) < 128) / len(text) >= threshold

    @staticmethod
    def is_bot_like(text: str) -> bool:
        """
        Flag content that is likely bot-generated or uninformative:
          - Very short (< 5 chars)
          - Single-word or highly repetitive
        """
        if len(text) < 5:
            return True
        words = text.split()
        if not words:
            return True
        top_freq = Counter(words).most_common(1)[0][1] / len(words)
        return top_freq > 0.60 and len(words) > 3

    def preprocess(self, df: pd.DataFrame, text_col: str = "fullText") -> pd.DataFrame:
        """Run preprocessing (no FinBERT inference). Adds 'cleaned_text' column."""
        if text_col not in df.columns:
            raise ValueError(f"Column '{text_col}' not found in DataFrame.")

        logger.info(f"Preprocessing {len(df):,} tweets...")
        df = df.drop_duplicates(subset=[text_col]).copy()
        df["cleaned_text"] = df[text_col].apply(self.clean_text)
        df = df[df["cleaned_text"].apply(self.is_english)].copy()
        df = df[~df["cleaned_text"].apply(self.is_bot_like)].copy()
        df = df[df["cleaned_text"].str.len() > 0].copy()
        df = df.reset_index(drop=True)
        logger.info(f"Preprocessing complete: {len(df):,} tweets retained.")
        return df

    def run_finbert(self, df: pd.DataFrame, text_col: str = "cleaned_text") -> pd.DataFrame:
        """
        Run batched FinBERT inference. Adds 'sentiment' and 'confidence' columns.
        Drops rows below min_confidence.
        """
        pipe  = self._load_pipeline()
        texts = df[text_col].tolist()
        sentiments, confidences = [], []

        logger.info(f"Running FinBERT on {len(texts):,} tweets...")
        for i in range(0, len(texts), self.batch_size):
            batch   = texts[i : i + self.batch_size]
            results = pipe(batch)
            for r in results:
                sentiments.append(r["label"])
                confidences.append(r["score"])
            if i % (self.batch_size * 50) == 0 and i > 0:
                logger.info(f"  {min(i + self.batch_size, len(texts)):,} / {len(texts):,} done")

        out = df.copy()
        out["sentiment"]  = [self.LABEL_MAP.get(s, "Neutral") for s in sentiments]
        out["confidence"] = confidences

        n_before = len(out)
        out = out[out["confidence"] >= self.min_confidence].copy()
        logger.info(
            f"FinBERT complete: {len(out):,} retained "
            f"(dropped {n_before - len(out):,} low-confidence)"
        )
        return out.reset_index(drop=True)

    def load_and_process(
        self,
        df: pd.DataFrame,
        text_col: str = "fullText",
        run_inference: bool = True,
    ) -> pd.DataFrame:
        """Convenience wrapper: preprocess + optionally run FinBERT."""
        df = self.preprocess(df, text_col)
        if run_inference:
            df = self.run_finbert(df, text_col="cleaned_text")
        return df


