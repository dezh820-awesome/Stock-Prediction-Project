class StatisticalValidator:
    """Statistical testing and diagnostics utilities."""

    def __init__(self, confidence_level: float = 0.95, random_state: int = 42):
        self.confidence_level = confidence_level
        self.random_state     = random_state
        np.random.seed(random_state)

    def check_all_assumptions(
        self,
        y_true: np.ndarray,
        y_pred: np.ndarray,
        X_matrix: np.ndarray,
        feature_names: List[str],
    ) -> AssumptionTestResults:
        """Run diagnostics on residuals and multicollinearity checks."""
        residuals = y_true - y_pred
        res       = AssumptionTestResults()

        # Residual summary statistics
        res.residual_mean     = float(np.mean(residuals))
        res.residual_std      = float(np.std(residuals))
        res.residual_skew     = float(stats.skew(residuals))
        res.residual_kurtosis = float(stats.kurtosis(residuals))

        # ── Linearity proxy: residuals should not correlate strongly with fitted ──
        if np.std(y_pred) > 1e-12 and np.std(residuals) > 1e-12:
            corr = float(np.corrcoef(y_pred, residuals)[0, 1])
        else:
            corr = 0.0
        res.residual_pred_corr = corr
        res.linearity_pass = abs(corr) < 0.10

        # ── Independence ──────────────────────────────────────────────────────
        res.durbin_watson_stat = float(durbin_watson(residuals))
        res.independence_pass  = 1.5 < res.durbin_watson_stat < 2.5
        try:
            lb = acorr_ljungbox(residuals, lags=[10], return_df=True)
            res.ljung_box_stat = float(lb["lb_stat"].iloc[0])
            res.ljung_box_p    = float(lb["lb_pvalue"].iloc[0])
        except Exception:
            res.ljung_box_p = 1.0

        # ── Normality ─────────────────────────────────────────────────────────
        sample = residuals
        if len(residuals) > 5_000:
            rng    = np.random.default_rng(self.random_state)
            sample = rng.choice(residuals, 5_000, replace=False)
        sw_stat, sw_p         = stats.shapiro(sample)
        res.shapiro_wilk_stat = float(sw_stat)
        res.shapiro_wilk_p    = float(sw_p)
        jb_stat, jb_p         = jarque_bera(residuals)
        res.jarque_bera_stat  = float(jb_stat)
        res.jarque_bera_p     = float(jb_p)
        res.normality_pass    = (sw_p > 0.05) and (jb_p > 0.05)

        # ── Homoscedasticity ──────────────────────────────────────────────────
        X_const = sm.add_constant(X_matrix)
        try:
            bp_stat, bp_p, _, _        = het_breuschpagan(residuals, X_const)
            res.breusch_pagan_stat     = float(bp_stat)
            res.breusch_pagan_p        = float(bp_p)
            res.homoscedasticity_pass  = bp_p > 0.05
        except Exception:
            res.breusch_pagan_p        = 1.0
            res.homoscedasticity_pass  = True

        # ── Multicollinearity (VIF) ───────────────────────────────────────────
        if X_matrix.shape[1] > 1:
            vif_dict, high_vif = {}, []
            for i in range(X_matrix.shape[1]):
                name = feature_names[i] if i < len(feature_names) else f"x{i}"
                try:
                    v = variance_inflation_factor(X_const, i + 1)
                    vif_dict[name] = float(v)
                    if v > 10.0:
                        high_vif.append(name)
                except Exception:
                    vif_dict[name] = 0.0
            res.vif_values             = vif_dict
            res.max_vif                = float(max(vif_dict.values())) if vif_dict else 0.0
            res.mean_vif               = float(np.mean(list(vif_dict.values()))) if vif_dict else 0.0
            res.high_vif_features      = high_vif
            res.multicollinearity_pass = res.max_vif < 10.0
        else:
            res.multicollinearity_pass = True

        res.all_pass = (
            res.linearity_pass
            and res.independence_pass
            and res.normality_pass
            and res.homoscedasticity_pass
            and res.multicollinearity_pass
        )
        return res

    def run_ols_inference(
        self,
        y_train: np.ndarray,
        X_train_scaled: np.ndarray,
        feature_names: List[str],
    ) -> InferenceResults:
        """
        Statsmodels OLS inference on the provided design matrix.
        (Note: if your predictive model is Ridge/Lasso, interpret these OLS
        p-values as a descriptive / comparative inference layer.)
        """
        X_sm  = sm.add_constant(X_train_scaled)
        ols   = sm.OLS(y_train, X_sm).fit()

        names = ["intercept"] + list(feature_names)
        ci    = ols.conf_int(alpha=1 - self.confidence_level)

        coeff_df = pd.DataFrame({
            "feature":         names,
            "coefficient":     ols.params,
            "std_error":       ols.bse,
            "t_stat":          ols.tvalues,
            "p_value":         ols.pvalues,
            "ci_lower":        ci[0],
            "ci_upper":        ci[1],
            "abs_coefficient": np.abs(ols.params),
            "significant":     ols.pvalues < (1 - self.confidence_level),
        }).reset_index(drop=True)

        return InferenceResults(
            coefficients     = coeff_df,
            f_stat           = float(ols.fvalue),
            f_pvalue         = float(ols.f_pvalue),
            adj_r2           = float(ols.rsquared_adj),
            aic              = float(ols.aic),
            bic              = float(ols.bic),
            condition_number = float(np.linalg.cond(X_sm)),
            n_obs            = int(ols.nobs),
            df_resid         = int(ols.df_resid),
        )

    def nested_f_test(
        self,
        y: np.ndarray,
        y_pred_restricted: np.ndarray,
        y_pred_full: np.ndarray,
        k_restricted: int,
        k_full: int,
    ) -> Tuple[float, float]:
        """Nested F-test comparing restricted vs full model SSE."""
        n     = len(y)
        sse_r = float(np.sum((y - y_pred_restricted) ** 2))
        sse_f = float(np.sum((y - y_pred_full) ** 2))
        q     = k_full - k_restricted
        dof_f = n - k_full - 1

        if dof_f <= 0 or q <= 0 or sse_f <= 0:
            return 0.0, 1.0

        f_stat = ((sse_r - sse_f) / q) / (sse_f / dof_f)
        p_val  = float(1 - stats.f.cdf(f_stat, dfn=q, dfd=dof_f))
        return float(f_stat), p_val

    def bootstrap_delta_r2(
        self,
        y: np.ndarray,
        y_pred_baseline: np.ndarray,
        y_pred_full: np.ndarray,
        n_iter: int = 1_000,
    ) -> Tuple[float, float, float, np.ndarray]:
        """Bootstrap CI for ΔR² = R²(full) − R²(baseline)."""
        n      = len(y)
        deltas = np.empty(n_iter)
        rng    = np.random.default_rng(self.random_state)

        for i in range(n_iter):
            idx       = rng.integers(0, n, size=n)
            r2_b      = r2_score(y[idx], y_pred_baseline[idx])
            r2_f      = r2_score(y[idx], y_pred_full[idx])
            deltas[i] = r2_f - r2_b

        alpha    = (1 - self.confidence_level) / 2
        ci_lo    = float(np.percentile(deltas, 100 * alpha))
        ci_hi    = float(np.percentile(deltas, 100 * (1 - alpha)))
        observed = float(r2_score(y, y_pred_full) - r2_score(y, y_pred_baseline))

        return observed, ci_lo, ci_hi, deltas

    @staticmethod
    def no_information_benchmarks(y_train: np.ndarray, y_test: np.ndarray) -> Dict[str, float]:
        """R² and RMSE for random-walk (predict 0) and mean predictor."""
        mean_const = np.full_like(y_test, np.mean(y_train))
        zero_const = np.zeros_like(y_test)
        return {
            "random_walk_r2":    float(r2_score(y_test, zero_const)),
            "mean_predictor_r2": float(r2_score(y_test, mean_const)),
            "random_walk_rmse":  float(np.sqrt(mean_squared_error(y_test, zero_const))),
            "mean_pred_rmse":    float(np.sqrt(mean_squared_error(y_test, mean_const))),
        }


