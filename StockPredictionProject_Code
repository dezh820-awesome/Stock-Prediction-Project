def load_tweet_data(
    kaggle_path: str = "dadalyndell/elon-musk-tweets-2010-to-2025-march",
    file_path: str = "all_musk_posts.csv",
) -> pd.DataFrame:
    """Load the Elon Musk tweet dataset from Kaggle via kagglehub."""
    try:
        import kagglehub
        from kagglehub import KaggleDatasetAdapter
        df = kagglehub.load_dataset(KaggleDatasetAdapter.PANDAS, kaggle_path, file_path)
        logger.info(f"Loaded {len(df):,} tweets from Kaggle.")
        return df
    except ImportError as e:
        raise ImportError("kagglehub required: pip install kagglehub[pandas-datasets]") from e


def load_ohlcv_data(
    symbol: str = "TSLA",
    start: str = "2010-01-01",
    end: str = "2025-10-31",
    api_key: str = "",
    dataset: str = "EQUS.MINI",
) -> pd.DataFrame:
    """Load OHLCV data from DataBento."""
    try:
        import databento as db
        client = db.Historical(api_key)
        ohlcv  = client.timeseries.get_range(
            dataset=dataset, schema="ohlcv-1d",
            symbols=symbol, start=start, end=end,
        )
        df = ohlcv.to_df()
        df.index   = pd.to_datetime(df.index).date
        df.columns = [c.lower() for c in df.columns]
        logger.info(f"Loaded {len(df):,} OHLCV rows from DataBento.")
        return df
    except ImportError as e:
        raise ImportError("databento required: pip install databento") from e


